generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LoginMethod {
  LOCAL
  GOOGLE
  RIOT
}

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  name            String?
  password        String?
  username        String?      @unique
  avatarUrl       String?      @map("avatar_url")

  googleId        String?      @unique @map("google_id")
  riotPuuid       String?      @unique @map("riot_puuid")
  riotGameName    String?      @map("riot_game_name")
  riotTagLine     String?      @map("riot_tag_line")

  isEmailVerified Boolean      @default(false) @map("is_email_verified")
  lastLoginMethod LoginMethod  @default(LOCAL) @map("last_login_method")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  sessions        Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  deviceId     String   @map("device_id")
  userAgent    String   @map("user_agent")
  ipAddress    String   @map("ip_address")
  country      String   @default("Unknown")
  city         String   @default("Unknown")
  deviceType   String   @default("Unknown") @map("device_type")
  os           String   @default("Unknown")
  browserName  String   @default("Unknown") @map("browser_name")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, deviceId])
  @@map("sessions")
}
model Champion {
  id           String          @id // Riot Champion Key (e.g. "133", "103", "64")
  key          String          @unique // e.g. "Quinn", "Ahri", "LeeSin"
  name         String          // e.g. "Quinn", "Ahri", "Lee Sin"
  title        String          // e.g. "Demacia's Wings"
  primaryClass String          // e.g. "Marksman", "Mage", "Fighter", "Tank", "Assassin", "Support"
  tags         Tag[]
  partype      String          // e.g. "Mana", "Energy"
  avatarUrl    String
  splashUrl    String
  abilities    Json            // { passive: {...}, q: {...}, w: {...}, e: {...}, r: {...} }
  builds       ChampionBuild[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([name])
  @@map("champions")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique // e.g. "Marksman", "Mage", "Assassin", "Fighter", "Tank", "Support"
  champions Champion[]
  createdAt DateTime   @default(now())

  @@index([name])
  @@map("tags")
}

model ChampionBuild {
  id               String   @id @default(uuid())
  championId       String
  champion         Champion @relation(fields: [championId], references: [id], onDelete: Cascade)
  role             String   // "top" | "jungle" | "mid" | "adc" | "support"
  tier             String   // "EMERALD+" | "ALL" | "DIAMOND+" ...
  region           String   // "WORLD" | "KR" | "NA" ...
  patch            String   // "14.24" | "14.24.1"
  tierRank         String   // "S+" | "S" | "A" | "B"
  winRate          Float
  pickRate         Float
  banRate          Float
  gamesPlayed      Int
  availableRoles   Json?    // RolePlayRate[]
  damageBreakdown  Json     // { physical, magic, trueDamage }
  previousPatch    Json     // { patch, winRate, winRateDiff, trend, gamesPlayed }
  spells           Json     // SpellPair[]
  runes            Json     // { mostPopular, highestWinRate }
  skills           Json     // SkillPriority { maxOrder, progression, winRate, pickRate }
  items            Json     // { starting, early, core, completed, buildOrder, boots, situational, trinkets }
  matchups         Json     // { bestAgainst, worstAgainst, strongAgainst, weakAgainst }
  similarChampions Json     // SimilarChampion[]
  insights         Json     // ChampionInsights { general, strengths, weaknesses }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([championId, role, tier, region, patch])
  @@index([championId, role])
  @@index([patch, role, tier])
  @@map("champion_builds")
}

model Role {
  id          String             @id // "top", "jungle", "mid", "ad", "sp"
  name        String             @unique // "TOP", "JUNGLE", "MID", "AD", "SP"
  displayName String             @map("display_name") // "Top", "Jungle", "Mid", "ADC", "Support"
  iconUrl     String?            @map("icon_url")
  tierStats   ChampionTierStat[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("roles")
}

model ChampionTierStat {
  id            String   @id @default(uuid())
  championId    String   @map("champion_id")
  name          String
  roleId        String   @map("role_id")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  rank          String   // "all", "iron", "bronze", "silver", "gold", "platinum", "emerald", "diamond", "master", "grandmaster", "challenger"
  tier          String   // "S", "A", "B", "C", "D"
  winRate       Float    @map("win_rate")
  patchWrChange Float    @map("patch_wr_change")
  banRate       Float    @map("ban_rate")
  pickRate      Float    @map("pick_rate")
  matches       Int
  avatarUrl     String   @map("avatar_url")
  patch         String   @default("14.24.1")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([championId, roleId, rank])
  @@index([rank, roleId])
  @@index([winRate(sort: Desc)])
  @@map("champion_tier_stats")
}
