generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ChampionTierStat {
  id            String   @id @default(uuid())
  championId    String   @map("champion_id")
  name          String
  role          String   // "top", "jungle", "mid", "ad", "sp"
  rank          String   // "all", "iron", "bronze", "silver", "gold", "platinum", "emerald", "diamond", "master", "grandmaster", "challenger"
  tier          String   // "S", "A", "B", "C", "D"
  winRate       Float    @map("win_rate")
  patchWrChange Float    @map("patch_wr_change")
  banRate       Float    @map("ban_rate")
  pickRate      Float    @map("pick_rate")
  matches       Int
  avatarUrl     String   @map("avatar_url")
  patch         String   @default("14.24.1")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([championId, role, rank])
  @@index([rank, role])
  @@index([winRate(sort: Desc)])
  @@map("champion_tier_stats")
}
