PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=group_backend_db
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/group_backend_db?schema=public"

# Redis configuration
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# JWT Secret Keys
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Riot Games (RSO) OAuth2 Credentials
RIOT_CLIENT_ID=your_riot_client_id
RIOT_CLIENT_SECRET=your_riot_client_secret
RIOT_CALLBACK_URL=http://localhost:3000/api/auth/riot/callback

# Riot Games Developer API Key
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx